"use strict";
// write code here
var field = document.querySelector(".field");
var tbody = field.querySelector("tbody");
var appendRowButton = document.querySelector(".append-row");
var removeRowButton = document.querySelector(".remove-row");
var appendColumnButton = document.querySelector(".append-column");
var removeColumnButton = document.querySelector(".remove-column");
appendRowButton.addEventListener("click", function() {
    var rows = tbody.querySelectorAll("tr");
    var newRow = document.createElement("tr");
    var numColumns = 2;
    if (rows.length > 0) numColumns = rows[0].cells.length;
    for(var i = 1; i <= numColumns; i++){
        var cell = document.createElement("td");
        newRow.appendChild(cell);
    }
    if (rows.length < 10) tbody.appendChild(newRow);
    updateButtonStates();
});
removeRowButton.addEventListener("click", function() {
    var rows = tbody.querySelectorAll("tr");
    if (rows.length > 2) {
        var lastRow = rows[rows.length - 1];
        lastRow.remove();
    }
    updateButtonStates();
});
appendColumnButton.addEventListener("click", function() {
    var rows = tbody.querySelectorAll("tr");
    var numColumns = 0;
    if (rows.length > 0) numColumns = rows[0].cells.length;
    if (numColumns < 10) rows.forEach(function(row) {
        var newCell = document.createElement("td");
        row.appendChild(newCell);
    });
    updateButtonStates();
});
removeColumnButton.addEventListener("click", function() {
    var rows = tbody.querySelectorAll("tr");
    var numColumns = 0;
    if (rows.length > 0) numColumns = rows[0].cells.length;
    if (numColumns > 2) rows.forEach(function(row) {
        row.deleteCell(row.cells.length - 1);
    });
    updateButtonStates();
});
function updateButtonStates() {
    var rows = tbody.querySelectorAll("tr");
    var numColumns = 0;
    if (rows.length > 0) numColumns = rows[0].cells.length;
    appendRowButton.disabled = rows.length >= 10;
    removeRowButton.disabled = rows.length <= 2;
    appendColumnButton.disabled = numColumns >= 10;
    removeColumnButton.disabled = numColumns <= 2;
}

